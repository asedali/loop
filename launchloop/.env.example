# Copy this file to .env for local development (Fly.io deploy uses `fly secrets set` instead — see README)

# Get a key at https://openrouter.ai/keys — OpenRouter gives access to many
# providers (Gemini, Claude, GPT, Llama, DeepSeek, etc.) through one API/key.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Any model slug OpenRouter hosts — browse https://openrouter.ai/models
# Free-tier-friendly examples: google/gemini-2.0-flash-exp:free,
# meta-llama/llama-3.1-70b-instruct:free, deepseek/deepseek-chat:free
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Any long random string — used to sign session cookies. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-something-random

# Only needed for local dev — on Fly.io this is set in fly.toml to /data/launchloop.db
LAUNCHLOOP_DB_PATH=./launchloop.db

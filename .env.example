# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Any OpenAI-SDK-shaped endpoint works: three variables describe it, and the app
# needs no code change to switch provider.
#
# OpenCode Zen — https://opencode.ai/auth (billing details required)
#   Model IDs are flat, with no vendor prefix, e.g. "glm-5.3" not "z-ai/glm-5.3".
LLM_BASE_URL=https://opencode.ai/zen/v1

# Blank this in the committed file. It is a real credential in your local .env,
# and publishing this file with a key in it hands the key to everyone.
LLM_API_KEY=

# Cheap, fast, good structured-output adherence, zero-retention on the provider.
# Alternatives on the same /chat/completions endpoint: deepseek-v4-flash,
# qwen3.8-max, kimi-k3, gemini-3.5-flash-lite, minmax-m3.
#
# Do NOT use big-pickle / mimo-* / ling-* here. Those are documented as possibly
# training on your prompts, and users paste unpublished research into this app.
LLM_MODEL=space-bunny-free

# Per-user LLM calls allowed per calendar month. 0 disables the cap.
# A full nine-block validation costs about 54 calls (9 blocks x 3 runs x
# 2 calls each), so 500 covers roughly nine complete validations.
LLM_MONTHLY_LIMIT_PER_USER=500

# --- per-request rate limiting on the LLM routes ---
# The monthly limit above is a *budget*; these are a *rate*. They stop one account
# (or one source address) from tying up a worker thread for the whole duration of
# a slow provider call. A request refused here is answered 429 before the model is
# called, so it writes no llm_calls row and does not consume the monthly budget.
# 0 disables a scope.
LLM_RATE_LIMIT_PER_MIN=12
# Per-IP ceiling, deliberately higher than the per-user one: universities and small
# companies put many researchers behind one NAT address.
LLM_RATE_LIMIT_IP_PER_MIN=60
# Window both scopes refill over.
LLM_RATE_LIMIT_WINDOW_SECONDS=60

# Seconds. Per-request timeout.
LLM_TIMEOUT=60
# Retry budget per call. Retries are exponential (2s, 4s, ...), so raising this
# on a flaky provider costs you wall-clock time as well as calls.
LLM_MAX_ATTEMPTS=3
# Per-response token ceiling, shared between reasoning and output.
# Raise it if the model keeps running out mid-answer; lower it for a hard spend
# cap per call.
LLM_MAX_OUTPUT_TOKENS=4096
# How hard a reasoning model thinks before answering: low | minimal | none.
# Reasoning draws from the SAME budget as output, so leaving this unbounded on a
# reasoning model means it can spend the entire ceiling thinking and return an
# empty message. Set to "none" for non-reasoning models that reject the
# parameter.
LLM_REASONING_EFFORT=low
# Set to 0 if your provider rejects response_format={"type":"json_object"}
# (the app also auto-retries without it if it sees that error).
LLM_JSON_MODE=1

# --- not listed above, because changing them is rare ---
# These have built-in defaults in app/config.py and are read only in the
# fallback path, so a normal setup never sets them. Listed here for the rare
# case where you are switching provider:
#
#   LLM_ZEN_BASE_URL          default https://opencode.ai/zen/v1
#   LLM_OPENROUTER_BASE_URL   default https://openrouter.ai/api/v1
#   LLM_DEFAULT_MODEL         used only when LLM_MODEL is unset
#   LLM_PROVIDER              a label for logs; inferred from the URL if unset
#   OPENROUTER_API_KEY        fallback provider, used only if BOTH LLM_BASE_URL
#   OPENROUTER_MODEL          and LLM_API_KEY are unset. OPENROUTER_MODEL must be
#                             OpenRouter's own vendor-prefixed id, never the Zen
#                             one: falling back while sending a flat id yields a
#                             model that does not exist there.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase Postgres. Copy the "Session pooler" string from
# Project Settings -> Database -> Connection string (URI), not the Transaction
# pooler: port 6543 breaks the server-side prepared statements SQLAlchemy sends,
# which shows up as intermittent runtime errors rather than a clean failure.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
#
# Three things that are easy to get wrong:
#   1. The username must include the project ref (postgres.<project-ref>). Plain
#      "postgres" fails with "FATAL: no tenant identifier provided".
#   2. sslmode must be verify-full, not require. The pooler identifies your
#      project from the TLS SNI, which libpq omits under "require".
#   3. sslrootcert is required because Supabase's cert is signed by Supabase's
#      own CA, not a public one. certs/supabase-ca.crt ships in the repo; the
#      path is resolved relative to the project root, so it works from any CWD.
DATABASE_URL=

# The NOBYPASSRLS role the app switches to with SET LOCAL ROLE. This is what
# makes the row-level security policies actually apply, and it is the single
# most important line in this file for tenant safety.
#
# Row-level security is INERT for a role with the BYPASSRLS attribute, and so is
# FORCE ROW LEVEL SECURITY for a superuser. Supabase's service_role has BYPASSRLS,
# so a DATABASE_URL pointing at service_role means every policy is decoration. To
# get real enforcement on Supabase, in the SQL editor as the postgres superuser:
#
#   CREATE ROLE launchloop_app NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;
#   GRANT launchloop_app TO service_role;
#
# Leave DATABASE_URL alone — the app switches roles at runtime rather than
# connecting as a different user, so the pooler and TLS settings keep working.
#
# The switch is membership-tested per connection, so if that GRANT was skipped the
# app keeps working on the user_id filters alone instead of 500-ing on every
# request. GET /healthz reports {"rls": true|false} either way — check it after
# deploying rather than assuming.
DB_APP_ROLE=launchloop_app

# Where the test suite runs its migrations. Must be a database you are willing
# to have schemas created and dropped in — the suite creates and drops one
# schema per test. Point it at a local Postgres, never at production.
# Defaults to DATABASE_URL if unset, then to localhost/launchloop_test.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# App config
# ---------------------------------------------------------------------------
# Required in production — the app refuses to boot without it. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Set to 1 when serving over HTTPS (i.e. on Fly) so the session cookie is never
# sent in plaintext. Keep 0 for plain-http localhost development.
SESSION_HTTPS_ONLY=0

# Set to 1 to allow a development default session secret and other relaxations.
# Never enable in production.
LAUNCHLOOP_DEBUG=0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Minimum accepted password length, in characters.
MIN_PASSWORD_LENGTH=8
# Sliding window for login throttling, in minutes.
LOGIN_WINDOW_MINUTES=15
# Failed logins allowed inside that window before the account is locked out of
# further attempts.
MAX_FAILED_LOGINS=8

# ---------------------------------------------------------------------------
# Phase 1 — idea extraction
# ---------------------------------------------------------------------------
# Most idea cards rendered from one paste of research material.
IDEA_CARD_LIMIT=12

# ---------------------------------------------------------------------------
# Phase 1 — file upload
# ---------------------------------------------------------------------------
# Uploads are read into memory, turned into text, and discarded. No file is ever
# written to disk, so there is nothing to scan, clean up, or path-traverse.
# Hard ceiling on what is accepted, enforced while reading rather than trusted
# from Content-Length.
MAX_UPLOAD_BYTES=8388608
# A thesis is longer than a paper; the user should upload the chapter or section.
MAX_PDF_PAGES=200
# Caps the text handed to the model, so a long document cannot become a huge
# prompt. The user is told when their text was truncated.
MAX_EXTRACTED_CHARS=200000
# Wall-clock budget per file, checked *between pages*. A thread cannot be
# cancelled in CPython, so a future timeout would bound only the response and
# not the work — this is what actually stops a slow document.
MAX_PARSE_SECONDS=20

# ---------------------------------------------------------------------------
# Phase 1 — identifier import (ORCID / DOI / arXiv)
# ---------------------------------------------------------------------------
# Master switch. False hides the import box and refuses the route, for a
# deployment that must not make outbound requests to third parties.
SOURCE_IMPORT_ENABLED=true
# These three are public metadata APIs and answer in well under a second, so a
# slow one is a network problem and waiting longer only holds the worker.
IMPORT_TIMEOUT_SECONDS=10
# Ceiling on a third-party response body, applied while streaming rather than
# trusted from Content-Length. These APIs return metadata that gets truncated
# anyway, so an unexpectedly huge body is not worth buffering.
IMPORT_MAX_RESPONSE_BYTES=1000000
# How long a fetched record is served from memory without asking again. Public
# bibliographic data is stable; arXiv records can be revised, hence a day.
IMPORT_CACHE_TTL_SECONDS=86400
# Rows pulled out of a record. An ORCID iD is a *person* — a career's worth of
# works — so this is what stops a prolific researcher becoming a huge prompt.
IMPORT_MAX_WORKS=25
# Per-request brake, deliberately looser than the LLM routes: an import is one
# small GET to a public API and costs no monthly quota. It still needs a brake,
# because each request holds a worker thread for the round trip. 0 disables.
IMPORT_RATE_LIMIT_PER_MIN=20
IMPORT_RATE_LIMIT_IP_PER_MIN=60

# ---------------------------------------------------------------------------
# Phase 2 — the per-block validation loop
# ---------------------------------------------------------------------------
# Validation runs each canvas block gets before it is parked and offered an
# extension. This is the knob you will most want to tune.
SEGMENT_CAP=3
# Venture-wide runaway ceiling. Defaults to 9 blocks x SEGMENT_CAP, so raising
# SEGMENT_CAP alone widens it too.
VENTURE_RUN_BACKSTOP=27

# ---------------------------------------------------------------------------
# Password reset + email verification
# ---------------------------------------------------------------------------
# How long a reset or verification link stays live. Short on purpose: the link in
# the email IS the credential, and it is only useful while the user is present.
PASSWORD_RESET_TOKEN_MINUTES=30

# ---------------------------------------------------------------------------
# Transactional email
# ---------------------------------------------------------------------------
# console prints the message and its links to stdout — that is what dev and the
# test suite use, and it is why the reset flow is testable with no provider and no
# network. smtp talks to a real server. An unrecognised value degrades to console
# rather than failing closed, so a typo here cannot silently stop password
# resets working — but it will not send real mail either.
MAIL_BACKEND=console
MAIL_FROM=LaunchLoop <no-reply@launchloop.local>
# Must match how users actually reach the app, or every link in every email is
# broken. On Render this is the public URL of the service.
APP_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_TIMEOUT=20

# ---------------------------------------------------------------------------
# Email confirmation — off by default
# ---------------------------------------------------------------------------
# When 1, signup emails a confirmation link and unverified accounts see a
# reminder banner. Leave it unset (or 0) and both are switched off.
#
# It is off by default because there is no working sending path yet: the only
# backend configured anywhere is `console`, which prints to stdout rather than
# delivering. With the flag on and console as the backend, every account would
# see a banner forever asking it to click a link that never arrives in an inbox.
#
# Password reset is unaffected and still runs either way — but it is delivered by
# the same mailer, so on `console` its links are printed to stdout too, and
# nobody can actually recover a forgotten password.
#
# To turn confirmation on: set MAIL_BACKEND to a real provider, set MAIL_FROM to
# a sender on a domain you control (SPF/DKIM), then set this to 1.
EMAIL_VERIFICATION_ENABLED=0

# ---------------------------------------------------------------------------
# Not configurable, on purpose
# ---------------------------------------------------------------------------
#   The nine segment keys, their per-segment methods, and the run verdicts
#   (pass/iterate/fail/pivot) generate the Postgres CHECK constraints and the LLM
#   output allowlists. Making them env-driven would let the running code and the
#   live schema disagree, turning a verdict the model is allowed to emit into a
#   500. They live in app/constants.py.
#
#   MAX_PASSWORD_BYTES=72 in app/auth.py is bcrypt's own limit, not a policy
#   choice. Exposing it would let a deploy silently re-enable the silent
#   password truncation it exists to prevent.
#
# Everything else in the app is read from this file via app/config.py, which
# also enforces sane ranges — a blank or junk value falls back to the default
# rather than failing the request.
